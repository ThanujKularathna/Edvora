extend baseEmail

block content 
  tr
    td.wrapper
      p Hi #{firstName}
      p You requested to reset your password for your LMS account. Click the button below to reset it. If you didn't request this, please ignore this message.
      table.btn.btn-primary(role="presentation", border="0", cellpadding="0", cellspacing="0")
        tbody
          tr
            td(align="left")
              table(role="presentation", border="0", cellpadding="0", cellspacing="0")
                tbody
                  tr
                    td
                      a(href=`${url}`) Reset your Password
      p If you didn't forget your password please ignore this email
      p Thank you for using our LMS platform!